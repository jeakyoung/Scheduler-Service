# Copy this file to .env.local (gitignored) and fill in real values for local dev.
VITE_API_BASE_URL=http://localhost:8080

# LOCAL DEV ONLY - NEVER set this in production. Must be turned on together with the
# backend's AUTH_DISABLED=true (setting only one of the two leaves the app blocked - the
# backend one skips server-side token checks, this one skips the frontend's client-side
# route guard, and both gates are independent). See README.md.
VITE_AUTH_DISABLED=false
