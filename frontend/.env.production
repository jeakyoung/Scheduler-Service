# Production build (npm run build) - loaded by Vite in addition to .env, never .env.local.
# Empty on purpose (PLAN.md §11.4): `import.meta.env.VITE_API_BASE_URL ?? "http://localhost:8080"`
# in src/api/client.ts only falls back on null/undefined, not on an empty string, so this makes
# API_BASE_URL resolve to "" and every fetch() call become a same-origin relative path
# (`${API_BASE_URL}${path}` => just `${path}`). That works under any Tomcat context path the
# single integrated WAR (T22/T23) is deployed under, with no code change needed - see T25's
# DoD verification in .team/LOG.md.
VITE_API_BASE_URL=
VITE_AUTH_DISABLED=false
